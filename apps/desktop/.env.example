# =============================================
# APES Lab Desktop Kiosk - cấu hình
# =============================================
# Copy file này thành `.env` rồi điền thông tin thật.
# File .env KHÔNG được commit lên Git.

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL Edge Functions
# Thường là: https://your-project-ref.supabase.co/functions/v1
FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# Tên lab hiển thị trên kiosk
LAB_NAME=APES Lab

# Mã PIN để thoát chế độ kiosk (4-8 chữ số)
KIOSK_PIN=1234
