{
  "name": "@apes/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Types & logic dùng chung cho web-admin, desktop và mobile",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/rename-esm.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
