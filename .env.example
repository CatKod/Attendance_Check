# Supabase Configuration
# Copy file này thành .env và điền giá trị thật của bạn

# Project URL — lấy từ Supabase Dashboard → Settings → API
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon public key — an toàn cho client (web/mobile/desktop)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Service role key — CHỈ dùng cho backend/Edge Functions
# TUYỆT ĐỐI KHÔNG dùng ở client, KHÔNG commit lên Git
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database password (chỉ cần cho migration/local dev)
DATABASE_PASSWORD=your_database_password_here