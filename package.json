{
  "name": "apes-attendance-system",
  "version": "0.1.0",
  "private": true,
  "description": "APES Lab Attendance System - Web Admin, Desktop & Mobile",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web-admin",
    "build:web": "npm run build --workspace=apps/web-admin",
    "dev": "npm run dev:web",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "dist:desktop": "npm run dist:win --workspace=apps/desktop",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "android": "npm run android --workspace=apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:functions": "deno check supabase/functions/*/index.ts && deno lint supabase/functions/",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "rimraf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}